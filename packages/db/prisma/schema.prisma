enum ProviderType {
  CLINICA
  ENGENHEIRO
  TECNICO
  CONSULTORIA
  LABORATORIO
  OUTRO
}

/// Catálogo de prestadores do tenant — hoje por empresa; uma rede compartilhada
/// entre tenants (HydraNET "de verdade") exige um modelo de dados público
/// separado do isolamento por tenant e fica para uma fase futura.
model Provider {
