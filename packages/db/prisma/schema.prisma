// ---------------------------------------------------------------------------
// Gerador de Contratos — Administrativo (Fase 2)
// ---------------------------------------------------------------------------

/// Dados fixos da CONTRATADA (a própria ProtecSeg) usados em todo contrato
/// gerado — 1 registro por tenant, editável sem precisar de deploy.
model ContractIssuer {
  id               String   @id @default(cuid())
  tenantId         String   @unique
  name             String
  cnpj             String?
  cep              String?
  endereco         String?
  numero           String?
  complemento      String?
  bairro           String?
  cidade           String?
  estado           String?
  repNome          String?
  repNacionalidade String?
  repEstadoCivil   String?
  repProfissao     String?
  repRg            String?
  repCpf           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("contract_issuers")
}

/// Modelo de contrato reutilizável (ex.: "Consultoria e Assessoria em SST").
/// Arquitetura pensada para caber outros tipos de contrato no futuro — cada
/// um é só um novo ContractTemplate com suas próprias cláusulas.
model ContractTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clauses      ContractTemplateClause[]
  serviceItems ContractServiceItem[]
  contracts    Contract[]

  @@index([tenantId])
  @@map("contract_templates")
}

/// Uma cláusula fixa do modelo — texto com marcadores {{TOKEN}} resolvidos
/// na geração do PDF.
model ContractTemplateClause {
  id         String @id @default(cuid())
  tenantId   String
  templateId String
  order      Int
  title      String
  body       String @db.Text

  template ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([templateId])
  @@map("contract_template_clauses")
}

/// Item do catálogo de serviços do modelo (ex.: a lista a-s da Cláusula 2ª) —
/// cada contrato escolhe quais entram, relistados em ordem na geração.
model ContractServiceItem {
  id         String @id @default(cuid())
  tenantId   String
  templateId String
  order      Int
  text       String @db.Text

  template  ContractTemplate          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  contracts ContractSelectedService[]

  @@index([tenantId])
  @@index([templateId])
  @@map("contract_service_items")
}

enum ContractStatus {
  ATIVO
  CANCELADO
}

/// Um contrato gerado para um CONTRATANTE específico. Guarda sua PRÓPRIA
/// cópia dos dados da parte (não referencia Company ao vivo) — um contrato
/// assinado é um documento jurídico, não pode mudar sozinho se alguém editar
/// o cadastro da empresa depois. `companyId` é só referência opcional.
model Contract {
  id         String  @id @default(cuid())
  tenantId   String
  companyId  String?
  templateId String

  // Snapshot do CONTRATANTE
  razaoSocial  String
  nomeFantasia String?
  cnpj         String
  cep          String?
  endereco     String?
  numero       String?
  complemento  String?
  bairro       String?
  cidade       String?
  estado       String?

  // Representante legal do CONTRATANTE
  repNome          String
  repNacionalidade String?
  repEstadoCivil   String?
  repProfissao     String?
  repRg            String?
  repCpf           String?

  // Termos
  quantidadeVidas               Int?
  dataInicio                    DateTime
  prazoMeses                    Int       @default(12)
  dataVencimento                DateTime
  valorMensalidade              Float
  valorPrimeiraParcela          Float?
  dataVencimentoPrimeiraParcela DateTime?
  diaVencimentoMensal           Int?
  formaPagamento                String?
  qtdVisitas                    Int?
  frequenciaVisitas             String?
  observacoes                   String?   @db.Text

  status         ContractStatus @default(ATIVO)
  pdfUrl         String?
  pdfGeneratedAt DateTime?
  pdfSha256      String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  template   ContractTemplate          @relation(fields: [templateId], references: [id])
  services   ContractSelectedService[]
  signatures ContractSignature[]

  @@index([tenantId])
  @@index([companyId])
  @@index([templateId])
  @@map("contracts")
}

/// Serviços selecionados para um contrato específico (join simples).
model ContractSelectedService {
  id            String @id @default(cuid())
  tenantId      String
  contractId    String
  serviceItemId String

  contract    Contract            @relation(fields: [contractId], references: [id], onDelete: Cascade)
  serviceItem ContractServiceItem @relation(fields: [serviceItemId], references: [id])

  @@index([tenantId])
  @@index([contractId])
  @@map("contract_selected_services")
}

enum ContractSignatureRole {
  CONTRATANTE
  CONTRATADA
}

enum ContractSignatureMethod {
  DRAWN
  TYPED
}

/// Assinatura eletrônica simples (MP 2.200-2/2001) de uma das partes de um
/// Contract — uma linha por papel, criada via upsert quando o link é
/// solicitado (CONTRATANTE) ou no momento da assinatura (CONTRATADA).
/// Snapshot próprio (signerName/signerCpf): quem assinou não muda se o
/// cadastro mudar depois.
model ContractSignature {
  id         String                @id @default(cuid())
  tenantId   String
  contractId String
  role       ContractSignatureRole

  signerName String
  signerCpf  String?

  /// Só CONTRATADA — usuário autenticado que executou "Assinar como CONTRATADA".
  signedByUserId String?

  /// Só CONTRATANTE — hash do token enviado por link; o token bruto nunca é persistido.
  tokenHash String?   @unique
  expiresAt DateTime?

  signedAt        DateTime?
  signatureImage  Bytes?
  signatureMethod ContractSignatureMethod?

  /// SHA-256 do texto das cláusulas resolvidas no momento da assinatura —
  /// prova do que exatamente foi assinado.
  contentHash String?

  ip        String?
  userAgent String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, role])
  @@index([tenantId])
  @@index([contractId])
  @@map("contract_signatures")
}

enum CrmStage {
  LEAD
  CONTATO
  QUALIFICACAO
  PROPOSTA
  NEGOCIACAO
  CONTRATO
  CLIENTE
}

model CrmLead {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  contactName String?
  email       String?
  phone       String?
  stage       CrmStage @default(LEAD)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  tasks CrmTask[]

  @@index([tenantId])
  @@map("crm_leads")
}

model CrmTask {
  id          String    @id @default(cuid())
  tenantId    String
  leadId      String
  description String
  dueDate     DateTime?
  done        Boolean   @default(false)
  createdAt   DateTime  @default(now())

  lead CrmLead @relation(fields: [leadId], references: [id])

  @@index([tenantId])
  @@index([leadId])
  @@map("crm_tasks")
}

enum MedicalBillStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  GLOSSED
  PAID
}

/// Conferência de contas médicas — lote de serviços prestados por um provedor
/// de saúde ocupacional (clínica/laboratório), sujeito a glosa antes do pagamento.
model MedicalBill {
  id             String            @id @default(cuid())
  tenantId       String
  providerId     String
  companyId      String
  referenceMonth String // "2026-08"
  totalAmount    Float
  glossAmount    Float?
  glossReason    String?
  status         MedicalBillStatus @default(SUBMITTED)
  submittedAt    DateTime          @default(now())
  approvedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdById    String?

  provider Provider @relation(fields: [providerId], references: [id])

  @@index([tenantId])
  @@index([providerId])
  @@map("medical_bills")
}

enum PsychosocialSurveyStatus {
  DRAFT
  ACTIVE
  CLOSED
}

/// Módulo NR-01 — campanha de pesquisa de riscos psicossociais (ex.: aplicação
/// periódica do instrumento HSE-IT). Fase 1: cadastro da campanha + envio de
/// convites e monitoramento de participação — sem relatório de riscos nem
/// plano de ação ainda (fases futuras). As perguntas seguem um conjunto
/// fictício/de exemplo até o questionário oficial ser fornecido pelo cliente
/// — ver PSYCHOSOCIAL_SAMPLE_QUESTIONS em psychosocial.service.ts.
model PsychosocialSurvey {
  id          String                   @id @default(cuid())
  tenantId    String
  companyId   String
  branchId    String?
  title       String
  description String?                  @db.Text
  status      PsychosocialSurveyStatus @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  deletedAt   DateTime?
  createdById String?

  questions PsychosocialQuestion[]
  invites   PsychosocialInvite[]
  responses PsychosocialResponse[]

  @@index([tenantId])
  @@index([companyId])
  @@map("psychosocial_surveys")
}

/// Pergunta da pesquisa, agrupada por dimensão (categoria do instrumento —
/// ex.: HSE-IT usa Demandas, Controle, Apoio da Chefia, Apoio dos Colegas,
/// Relacionamentos, Papel, Mudança).
model PsychosocialQuestion {
  id        String @id @default(cuid())
  tenantId  String
  surveyId  String
  dimension String
  text      String @db.Text
  order     Int    @default(0)

  survey  PsychosocialSurvey   @relation(fields: [surveyId], references: [id])
  answers PsychosocialAnswer[]

  @@index([tenantId])
  @@index([surveyId])
  @@map("psychosocial_questions")
}

/// Convite individual de um colaborador para responder a pesquisa — rastreia
/// participação (quem já respondeu) sem vincular a resposta em si ao
/// colaborador, preservando o anonimato exigido pela metodologia.
model PsychosocialInvite {
  id          String    @id @default(cuid())
  tenantId    String
  surveyId    String
  employeeId  String
  token       String    @unique @default(cuid())
  sentAt      DateTime  @default(now())
  respondedAt DateTime?

  survey PsychosocialSurvey @relation(fields: [surveyId], references: [id])

  @@unique([surveyId, employeeId])
  @@index([tenantId])
  @@index([surveyId])
  @@index([employeeId])
  @@map("psychosocial_invites")
}

/// Submissão anônima do questionário — deliberadamente sem employeeId; carrega
/// apenas um setor autodeclarado (opcional) para permitir segmentação sem
/// quebrar o anonimato da resposta.
model PsychosocialResponse {
  id           String   @id @default(cuid())
  tenantId     String
  surveyId     String
  /// CPF mascarado (ex.: "123.***.***-00") — nunca o CPF completo, para
  /// pseudonimização conforme LGPD. Autodeclarado na tela de identificação.
  cpfMasked    String?
  branchId     String?
  departmentId String?
  positionId   String?
  gheId        String?
  submittedAt  DateTime @default(now())

  survey  PsychosocialSurvey   @relation(fields: [surveyId], references: [id])
  answers PsychosocialAnswer[]

  @@index([tenantId])
  @@index([surveyId])
  @@map("psychosocial_responses")
}

/// Resposta a uma pergunta específica — escala 1 (Nunca) a 5 (Sempre).
model PsychosocialAnswer {
  id         String @id @default(cuid())
  tenantId   String
  responseId String
  questionId String
  value      Int

  response PsychosocialResponse @relation(fields: [responseId], references: [id])
  question PsychosocialQuestion @relation(fields: [questionId], references: [id])

  @@index([tenantId])
  @@index([responseId])
  @@map("psychosocial_answers")
}

/// Catálogo de EPIs disponíveis para cadastro nas fichas de entrega — carga
/// inicial via seed (44 itens/9 categorias), editável depois pela tela.
model EpiCatalogItem {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  category       String
  mainProtection String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  deliveryItems        EpiDeliveryItem[]
  positionRequirements PositionRequiredEpi[]

  @@index([tenantId])
  @@map("epi_catalog_items")
}

/// Estoque de EPIs (controle de EPI): item, CA, quantidade e validade.
model EpiStockItem {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  ca          String?
  category    String?
  quantity    Int       @default(0)
  expiresAt   DateTime?
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?

  @@index([tenantId])
  @@map("epi_stock_items")
}

enum EpiDeliveryStatus {
  ATIVA
  CANCELADA
}

/// Ficha de entrega de EPI de um colaborador. Snapshot de setor/cargo/admissão
/// no momento da criação — mesmo motivo do Contract: a ficha assinada não pode
/// mudar sozinha se o cadastro do colaborador for editado depois.
model EpiDelivery {
  id             String            @id @default(cuid())
  tenantId       String
  companyId      String
  employeeId     String
  deliveryDate   DateTime
  employeeName   String
  departmentName String?
  positionName   String?
  admittedAt     DateTime?
  status         EpiDeliveryStatus @default(ATIVA)
  pdfUrl         String?
  pdfGeneratedAt DateTime?
  pdfSha256      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdById    String?

  employee  Employee              @relation(fields: [employeeId], references: [id])
  items     EpiDeliveryItem[]
  signature EpiDeliverySignature?

  @@index([tenantId])
  @@index([companyId])
  @@index([employeeId])
  @@map("epi_deliveries")
}

/// Um EPI entregue dentro de uma ficha. `epiName` é sempre gravado (snapshot,
/// funciona tanto pra item do catálogo quanto pra "outro" digitado na hora).
model EpiDeliveryItem {
  id                String    @id @default(cuid())
  tenantId          String
  deliveryId        String
  epiCatalogItemId  String?
  epiName           String
  ca                String?
  quantity          String?
  expiresAt         DateTime?
  periodicityMonths Int?
  observation       String?   @db.Text
  createdAt         DateTime  @default(now())

  delivery    EpiDelivery     @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  catalogItem EpiCatalogItem? @relation(fields: [epiCatalogItemId], references: [id])

  @@index([tenantId])
  @@index([deliveryId])
  @@map("epi_delivery_items")
}

/// Mesma forma de ContractSignature (assinatura eletrônica simples, MP 2.200-2/2001)
/// — Prisma não tem relação polimórfica, então é um model próprio em vez de
/// reaproveitar ContractSignature, mas compartilha o enum de método de assinatura.
model EpiDeliverySignature {
  id              String                   @id @default(cuid())
  tenantId        String
  deliveryId      String                   @unique
  signerName      String
  signerCpf       String?
  tokenHash       String?                  @unique
  expiresAt       DateTime?
  signedAt        DateTime?
  signatureImage  Bytes?
  signatureMethod ContractSignatureMethod?
  contentHash     String?
  ip              String?
  userAgent       String?                  @db.Text
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  delivery EpiDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("epi_delivery_signatures")
}

/// Ordem de Serviço (NR-01) — riscos e EPIs da função do colaborador, puxados
/// automaticamente do PGR Aprovado mais recente da empresa e do cadastro de
/// "EPIs exigidos por Cargo", e "congelados" (snapshot) na criação — é um
/// documento assinado, não pode mudar sozinho se o PGR ou o cargo mudarem depois.
model WorkOrder {
  id             String    @id @default(cuid())
  tenantId       String
  companyId      String
  employeeId     String
  /// Qual PGR aprovado alimentou esta OS — só rastreabilidade, não é live-join.
  referencePgrId String
  issueDate      DateTime
  employeeName   String // snapshot
  departmentName String?
  positionName   String?
  admittedAt     DateTime?
  pdfUrl         String?
  pdfGeneratedAt DateTime?
  pdfSha256      String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employee  Employee            @relation(fields: [employeeId], references: [id])
  riskItems WorkOrderRiskItem[]
  epiItems  WorkOrderEpiItem[]
  signature WorkOrderSignature?

  @@index([tenantId])
  @@index([companyId])
  @@index([employeeId])
  @@map("work_orders")
}

model WorkOrderRiskItem {
  id              String       @id @default(cuid())
  tenantId        String
  workOrderId     String
  hazardName      String // snapshot
  hazardCategory  RiskCategory
  gheName         String? // snapshot, só rastreabilidade
  typicalInjuries String?      @db.Text
  epiMeasures     String?      @db.Text
  riskLevel       RiskLevel
  createdAt       DateTime     @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([workOrderId])
  @@map("work_order_risk_items")
}

model WorkOrderEpiItem {
  id                String   @id @default(cuid())
  tenantId          String
  workOrderId       String
  epiName           String // snapshot
  ca                String?
  periodicityMonths Int?
  createdAt         DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([workOrderId])
  @@map("work_order_epi_items")
}

model WorkOrderSignature {
  id              String                   @id @default(cuid())
  tenantId        String
  workOrderId     String                   @unique
  signerName      String
  signerCpf       String?
  tokenHash       String?                  @unique
  expiresAt       DateTime?
  signedAt        DateTime?
  signatureImage  Bytes?
  signatureMethod ContractSignatureMethod?
  contentHash     String?
  ip              String?
  userAgent       String?                  @db.Text
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("work_order_signatures")
}

/// Risco do catálogo ligado a um cargo. Os campos são uma cópia do cadastro do risco
/// (editável por empresa) mais a avaliação feita para o cargo.
model PositionRisk {
  positionId   String
  hazardId     String
  exposureType ExposureType?
  sendEsocial  Boolean       @default(true)
  createdAt    DateTime      @default(now())

  description            String?            @db.Text
  damagePotential        String?            @db.Text
  observations           String?            @db.Text
  sourceCircumstances    String?            @db.Text
  adminMeasures          String?            @db.Text
  measurementType        EvaluationCriteria @default(QUALITATIVO)
  generatesUnhealthiness Boolean            @default(false)
  generatesHazardPay     Boolean            @default(false)
  specialRetirement      Boolean            @default(false)
  insertInAso            Boolean            @default(true)
  epcStatus              String             @default("NAO_SE_APLICA")
  epiStatus              String             @default("NAO_SE_APLICA")
  /// Avaliação: probabilidade e severidade de 1 a 5; certeza da estimativa de 1 (alta) a 3 (baixa).
  probability            Int?
  severity               Int?
  certainty              Int?

  position   Position                 @relation(fields: [positionId], references: [id], onDelete: Cascade)
  hazard     Hazard                   @relation(fields: [hazardId], references: [id])
  protection PositionRiskProtection[]

  @@id([positionId, hazardId])
  @@index([hazardId])
  @@map("position_risks")
}

/// EPC/EPI indicado para o risco naquele cargo.
model PositionRiskProtection {
  positionId  String
  hazardId    String
  equipmentId String

  risk      PositionRisk        @relation(fields: [positionId, hazardId], references: [positionId, hazardId], onDelete: Cascade)
  equipment ProtectionEquipment @relation(fields: [equipmentId], references: [id])

  @@id([positionId, hazardId, equipmentId])
  @@index([equipmentId])
  @@map("position_risk_protections")
}

/// Exame ocupacional exigido para o cargo.
model PositionExam {
  id         String   @id @default(cuid())
  tenantId   String
  positionId String
  name       String
  createdAt  DateTime @default(now())

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([positionId])
  @@map("position_exams")
}

enum ProtectionKind {
  EPC
  EPI
}

/// Categoria do Banco de Equipamentos de Proteção (EPC / EPI do cliente).
model ProtectionCategory {
  id        String         @id @default(cuid())
  tenantId  String
  kind      ProtectionKind
  name      String
  createdAt DateTime       @default(now())

  equipment ProtectionEquipment[]

  @@unique([tenantId, kind, name])
  @@map("protection_categories")
}

/// Equipamento de proteção (coletiva ou individual) do cliente, reaproveitável em vários riscos e empresas.
model ProtectionEquipment {
  id               String         @id @default(cuid())
  tenantId         String
  kind             ProtectionKind
  categoryId       String?
  name             String
  usefulLifeMonths Int?
  description      String         @db.Text
  createdAt        DateTime       @default(now())
  deletedAt        DateTime?

  category      ProtectionCategory?      @relation(fields: [categoryId], references: [id])
  hazards       HazardProtection[]
  positionRisks PositionRiskProtection[]

  @@index([tenantId, kind])
  @@map("protection_equipment")
}

/// EPC/EPI indicado para um risco do catálogo.
model HazardProtection {
  hazardId    String
  equipmentId String

  hazard    Hazard              @relation(fields: [hazardId], references: [id], onDelete: Cascade)
  equipment ProtectionEquipment @relation(fields: [equipmentId], references: [id])

  @@id([hazardId, equipmentId])
  @@index([equipmentId])
  @@map("hazard_protections")
}

enum ActionScheduleMode {
  DRAFT
  DEFINED
}

enum ActionScheduleType {
  GERAL
  W5H2
}

/// Plano / Cronograma de Ações de uma empresa (aba Segurança).
model ActionSchedule {
  id           String             @id @default(cuid())
  tenantId     String
  companyId    String
  name         String
  author       String
  elaboratedAt DateTime           @db.Date
  mode         ActionScheduleMode @default(DRAFT)
  type         ActionScheduleType @default(GERAL)
  /// Primeiro mês do cronograma (dia 1); o quadro mostra 12 meses a partir dele.
  startMonth   DateTime           @db.Date
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?

  company Company              @relation(fields: [companyId], references: [id])
  items   ActionScheduleItem[]

  @@index([tenantId])
  @@index([companyId])
  @@map("action_schedules")
}

model ActionScheduleItem {
  id          String   @id @default(cuid())
  scheduleId  String
  position    Int
  what        String   @db.Text
  why         String?  @db.Text
  place       String?  @db.Text
  how         String?  @db.Text
  responsible String?
  totalCost   Decimal? @db.Decimal(14, 2)
  followUp    String?  @db.Text
  /// 0 (não informado) a 5 (intolerável).
  priority    Int      @default(0)
  /// Meses marcados no formato AAAA-MM.
  months      String[]

  schedule ActionSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@map("action_schedule_items")
}
