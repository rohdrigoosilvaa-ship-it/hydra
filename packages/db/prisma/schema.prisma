/// Documento LTCAT — mesmo padrão de versionamento do PGR/PCMSO. Reaproveita
/// os GHEs já cadastrados no PGR da empresa (ver Ghe.ltcatId) em vez de exigir
/// recadastro — só os campos de metadados abaixo têm paridade com o Pgr.
model Ltcat {
  id            String         @id @default(cuid())
  tenantId      String
  companyId     String
  branchId      String?
  title         String
  version       Int            @default(1)
  status        DocumentStatus @default(DRAFT)
  artNumber     String?
  validFrom     DateTime?
  validUntil    DateTime?
  responsibleId String?

  code                          String?
  issuedAt                      DateTime?
  preparedBy                    String?
  reviewedBy                    String?
  approvedBy                    String?
  companyResponsibleName        String?
  companyResponsibleRole        String?
  technicalResponsibleName      String?
  technicalResponsibleSpecialty String?
  technicalResponsibleRegistry  String?
  technicalResponsibleCouncil   String?
  technicalResponsibleUf        String?

  approvedAt   DateTime?
  approvedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdById  String?
  updatedById  String?

  ghes   Ghe[]
  agents LtcatAgent[]

  @@index([tenantId])
  @@index([companyId])
  @@map("ltcats")
}

/// Agente ambiental (físico/químico/biológico) identificado num GHE, conforme
/// avaliação do LTCAT (NR-09) — estrutura própria, distinta de PgrRisk (que é
/// sobre risco/probabilidade/severidade, não sobre medição de agente).
model LtcatAgent {
  id                     String       @id @default(cuid())
  tenantId               String
  ltcatId                String
  gheId                  String?
  agentCategory          RiskCategory
  agentName              String
  intensityConcentration String?
  toleranceLimit         String?
  measurementMethod      String?
  exposureTechnique      String?
  effectiveEpi           String?      @db.Text
  conclusion             String?      @db.Text
  createdById            String?
  updatedById            String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  ltcat Ltcat @relation(fields: [ltcatId], references: [id])
  ghe   Ghe?  @relation(fields: [gheId], references: [id])

  @@index([tenantId])
  @@index([ltcatId])
  @@map("ltcat_agents")
}

enum TechnicalReportType {
  INSALUBRIDADE
