// HYDRA — núcleo organizacional (Fase 1)
// Convenções (ver docs/hydra-arquitetura.html, seção 04):
//   - toda tabela de negócio carrega tenantId
//   - soft delete via deletedAt
//   - createdById / updatedById para rastreabilidade (auditoria)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organização
// ---------------------------------------------------------------------------

/// Conta contratante do Hydra — fronteira de isolamento multi-tenant (RLS).
model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  companies       Company[]
  users           User[]
  roleAssignments RoleAssignment[]
  auditLogs       AuditLog[]

  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELED
}

/// Entidade legal (CNPJ) dentro de um tenant — um grupo econômico pode ter várias.
model Company {
  id        String       @id @default(cuid())
  tenantId  String
  name      String
  legalName String?
  cnpj      String?
  status    RecordStatus @default(ACTIVE)

  // Identificação (documentos e registros — nem toda empresa tem todos)
  unidadeContratante Boolean @default(false) @map("unidade_contratante") // assina contratos diretamente, não só opera
  cpf                String? // pessoa física / MEI, quando não há CNPJ
  cei                String? // Cadastro Específico do INSS (legado)
  caepf              String? // Cadastro de Atividade Econômica de Pessoa Física
  cno                String? // Cadastro Nacional de Obras
  inscricaoEstadual  String? @map("inscricao_estadual")
  inscricaoMunicipal String? @map("inscricao_municipal")
  telefone           String?
  codigoRH           String? @map("codigo_rh") // referência no sistema de RH/folha, quando houver

  logoUrl String? @map("logo_url") // logo da empresa, reaproveitado nos documentos gerados (PGR, LTCAT, Ordem de Serviço)

  // CNAE e caracterização de risco (NR-1/NR-4)
  cnae                    String?
  cnaeSecundario          String? @map("cnae_secundario")
  grauRisco               Int?    @map("grau_risco") // 1-4, NR-4
  caracterizacaoProcessos String? @map("caracterizacao_processos") @db.Text
  descricaoLocal          String? @map("descricao_local") @db.Text
  desconsiderarEsocial    Boolean @default(false) @map("desconsiderar_esocial")

  // Endereço
  cep         String?
  endereco    String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?

  // Endereço de cobrança (quando diferente do endereço acima)
  cepCobranca         String? @map("cep_cobranca")
  enderecoCobranca    String? @map("endereco_cobranca")
  numeroCobranca      String? @map("numero_cobranca")
  complementoCobranca String? @map("complemento_cobranca")
  bairroCobranca      String? @map("bairro_cobranca")
  cidadeCobranca      String? @map("cidade_cobranca")
  estadoCobranca      String? @map("estado_cobranca")

  // Contrato / PPP / ASO / Brigada de incêndio
  dataContrato      DateTime?
  observacaoPPP     String?   @map("observacao_ppp") @db.Text
  observacaoASO     String?   @map("observacao_aso") @db.Text
  percentualBrigada Float?    @map("percentual_brigada") // % de colaboradores considerados no cálculo da brigada
  /// Vidas contratadas (base do faturamento) — o que passar disso aparece como "vidas excedentes".
  contractedLives   Int?      @map("contracted_lives")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  branches     Branch[]
  positions    Position[]
  environments WorkEnvironment[]
  schedules    ActionSchedule[]
  departments  Department[]
  employees    Employee[]

  @@index([tenantId])
  @@map("companies")
}

/// Filial ("Unidade" na navegação Cadastros → Estrutura → Unidade).
model Branch {
  id          String       @id @default(cuid())
  tenantId    String
  companyId   String
  code        String?
  name        String
  cnpj        String?
  cep         String?
  address     String?
  numero      String?
  complemento String?
  bairro      String?
  city        String?
  state       String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  company     Company      @relation(fields: [companyId], references: [id])
  units       Unit[]
  employees   Employee[]
  departments Department[]

  @@index([tenantId])
  @@index([companyId])
  @@map("branches")
}

/// Unidade operacional / site dentro de uma filial (ex.: terminal, porto, base).
model Unit {
  id          String       @id @default(cuid())
  tenantId    String
  branchId    String
  name        String
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  branch    Branch     @relation(fields: [branchId], references: [id])
  employees Employee[]

  @@index([tenantId])
  @@index([branchId])
  @@map("units")
}

/// Setor — relacionado a uma Unidade (Branch); `branchId` opcional para não
/// quebrar setores já cadastrados antes da tela de Unidade existir.
model Department {
  id        String       @id @default(cuid())
  tenantId  String
  companyId String
  branchId  String?
  code      String?
  name      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  company      Company       @relation(fields: [companyId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])
  employees    Employee[]
  gheFunctions GheFunction[]

  @@index([tenantId])
  @@index([companyId])
  @@index([branchId])
  @@map("departments")
}

/// Cargo/função — nível de empresa (reaproveitável entre filiais).
model Position {
  id                             String       @id @default(cuid())
  tenantId                       String
  companyId                      String
  code                           String?
  name                           String
  cbo                            String?
  /// Atividades / descrição do cargo (conforme CBO) — reaproveitada por todo
  /// colaborador com esse cargo, exibida (somente leitura) na ficha dele.
  description                    String?      @db.Text
  /// Cor e ícone de identificação do cargo na tela da empresa.
  color                          String?
  icon                           String?
  /// Início da validade dos dados para o eSocial.
  esocialStartDate               DateTime?
  /// Exige ASO com aptidão para entrar no cargo (admissão).
  requiresEntryAptitude          Boolean      @default(false)
  sectorInfo                     String?      @db.Text
  /// Jornada de trabalho / horário do cargo.
  workSchedule                   String?
  additionalInfo                 String?      @db.Text
  technicalOpinion               String?      @db.Text
  /// Informações complementares (só valem quando ligadas).
  complementaryInfoEnabled       Boolean      @default(false)
  safetyRecommendations          String?      @db.Text
  gfipCode                       String?
  ergonomicMethodology           String?      @db.Text
  generalNotes                   String?      @db.Text
  /// Pareceres técnicos (só valem quando ligados).
  technicalOpinionEnabled        Boolean      @default(false)
  ltcatOpinionNotes              String?      @db.Text
  ltcatOpinionConclusion         String?      @db.Text
  hazardPayOpinionNotes          String?      @db.Text
  hazardPayOpinionConclusion     String?      @db.Text
  unhealthinessOpinionNotes      String?      @db.Text
  unhealthinessOpinionConclusion String?      @db.Text
  status                         RecordStatus @default(ACTIVE)
  createdAt                      DateTime     @default(now())
  updatedAt                      DateTime     @updatedAt
  deletedAt                      DateTime?

  company      Company               @relation(fields: [companyId], references: [id])
  environments PositionEnvironment[]
  employees    Employee[]
  gheFunctions GheFunction[]
  requiredEpis PositionRequiredEpi[]
  risks        PositionRisk[]
  exams        PositionExam[]

  @@index([tenantId])
  @@index([companyId])
  @@map("positions")
}

/// EPIs que um Cargo exige — cadastrado manualmente uma vez por cargo, usado
/// pela Ordem de Serviço pra puxar automaticamente os EPIs da função do
/// colaborador (sem isso, não existe nenhum vínculo entre Cargo e EPI).
enum EnvironmentUnitType {
  MATRIZ
  FILIAL
}

/// Ambiente de trabalho da empresa (vinculado à empresa; os cargos transitam por ele e os riscos se ligam ao cargo).
model WorkEnvironment {
  id          String              @id @default(cuid())
  tenantId    String
  companyId   String
  name        String
  color       String?
  icon        String?
  description String?             @db.Text
  location    String?
  unitType    EnvironmentUnitType @default(MATRIZ)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  company   Company               @relation(fields: [companyId], references: [id])
  positions PositionEnvironment[]

  @@index([tenantId])
  @@index([companyId])
  @@map("work_environments")
}

/// Ambientes pelos quais um cargo transita.
model PositionEnvironment {
  positionId    String
  environmentId String

  position    Position        @relation(fields: [positionId], references: [id], onDelete: Cascade)
  environment WorkEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@id([positionId, environmentId])
  @@index([environmentId])
  @@map("position_environments")
}

model PositionRequiredEpi {
  id                String   @id @default(cuid())
  tenantId          String
  positionId        String
  epiCatalogItemId  String?
  epiName           String // snapshot do nome — mesmo padrão "outro (digitar)" do EpiDeliveryItem
  ca                String?
  periodicityMonths Int?
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  position    Position        @relation(fields: [positionId], references: [id])
  catalogItem EpiCatalogItem? @relation(fields: [epiCatalogItemId], references: [id])

  @@index([tenantId])
  @@index([positionId])
  @@map("position_required_epis")
}

/// Pessoa física — colaborador. Pode ou não ter um User (login) associado.
model Employee {
  id           String  @id @default(cuid())
  tenantId     String
  companyId    String
  branchId     String?
  unitId       String?
  departmentId String?
  positionId   String?

  // Dados cadastrais
  name          String
  leaveReason   String?   @map("leave_reason") // Motivo Licença
  birthDate     DateTime? @map("birth_date")
  cpf           String?
  registration  String? // matrícula
  admittedAt    DateTime?
  inactivatedAt DateTime? @map("inactivated_at")
  sex           String? // "M" | "F" | "OUTRO" — livre para não travar dado real incompleto
  rg            String?
  rgIssueDate   DateTime? @map("rg_issue_date")
  rgIssuer      String?   @map("rg_issuer")
  rgExpiryDate  DateTime? @map("rg_expiry_date")
  nit           String? // NIT / PIS/PASEP
  ctps          String?
  ctpsSeries    String?   @map("ctps_series")
  ctpsIssueDate DateTime? @map("ctps_issue_date")
  ctpsState     String?   @map("ctps_state") // UF CTPS

  // Endereço
  cep           String?
  address       String?
  addressNumber String? @map("address_number")
  complement    String?
  neighborhood  String?
  city          String?
  state         String?
  homePhone     String? @map("home_phone")
  mobilePhone   String? @map("mobile_phone")
  smsOptIn      Boolean @default(false) @map("sms_opt_in")

  // Deficiência
  rehabilitated  Boolean @default(false)
  disabled       Boolean @default(false)
  disabilityType String? @map("disability_type")

  status      EmployeeStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  company       Company            @relation(fields: [companyId], references: [id])
  branch        Branch?            @relation(fields: [branchId], references: [id])
  unit          Unit?              @relation(fields: [unitId], references: [id])
  department    Department?        @relation(fields: [departmentId], references: [id])
  position      Position?          @relation(fields: [positionId], references: [id])
  user          User?
  medicalExams  MedicalExam[]
  absences      Absence[]
  documents     EmployeeDocument[]
  epiDeliveries EpiDelivery[]
  workOrders    WorkOrder[]

  @@index([tenantId])
  @@index([companyId])
  @@index([branchId])
  @@index([unitId])
  @@index([cpf])
  @@map("employees")
}

/// Histórico de importações de colaboradores via planilha (item 12 do pedido).
model EmployeeImportLog {
  id        String   @id @default(cuid())
  tenantId  String
  companyId String?
  userId    String
  fileName  String?
  totalRows Int
  created   Int
  updated   Int
  errors    Int
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@map("employee_import_logs")
}

enum EmployeeDocumentType {
  RG
  ASO
  PPP
  TREINAMENTO
  OUTRO
}

/// Documento com validade rastreado por colaborador (Controle de Vencimentos).
/// `name` é o rótulo livre para TREINAMENTO/OUTRO (ex.: "NR-35"); os demais
/// tipos já têm identidade própria (RG, ASO, PPP) e podem deixar `name` vazio.
model EmployeeDocument {
  id          String               @id @default(cuid())
  tenantId    String
  companyId   String
  employeeId  String
  type        EmployeeDocumentType
  name        String?
  issueDate   DateTime?
  expiryDate  DateTime?
  notes       String?              @db.Text
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  createdById String?
  updatedById String?

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([companyId])
  @@index([employeeId])
  @@index([expiryDate])
  @@map("employee_documents")
}

/// Catálogo de ocupações CBO (Classificação Brasileira de Ocupações) — dado de
/// referência público, compartilhado entre todos os tenants (não carrega
/// tenantId). Seed a partir da lista canônica oficial (ver prisma/cbo-seed.csv).
/// Tabela de CNAE com o grau de risco da NR-04 (Quadro I) — catálogo público, compartilhado entre tenants.
model CnaeNr04 {
  id          String @id @default(cuid())
  /// Código no formato oficial, ex.: "0111-3/01".
  code        String @unique
  description String
  /// Grau de risco da NR-04 (1 a 4).
  riskGrade   Int

  @@index([description])
  @@map("cnae_nr04")
}

model CboOccupation {
  id          String  @id @default(cuid())
  code        String  @unique
  title       String
  description String? @db.Text

  @@index([title])
  @@map("cbo_occupations")
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

// ---------------------------------------------------------------------------
// Identidade & acesso
// ---------------------------------------------------------------------------

/// Login. Um usuário pertence a um tenant "principal" mas pode ter vínculos
/// adicionais em outros tenants via RoleAssignment (caso de prestadores/consultores).
model User {
  id           String       @id @default(cuid())
  tenantId     String
  employeeId   String?      @unique
  email        String
  passwordHash String
  name         String
  status       UserStatus   @default(ACTIVE)
  authProvider AuthProvider @default(LOCAL)
  mfaEnabled   Boolean      @default(false)
  mfaSecret    String?
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  employee            Employee?            @relation(fields: [employeeId], references: [id])
  roleAssignments     RoleAssignment[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AuthProvider {
  LOCAL
  MICROSOFT_ENTRA
  GOOGLE
}

/// Vínculo de papel + escopo — a unidade real de permissão (ver seção 08).
model RoleAssignment {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  role      HydraRole
  scopeType ScopeType
  scopeId   String? // null quando scopeType = TENANT
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, tenantId, role, scopeType, scopeId])
  @@index([tenantId])
  @@index([userId])
  @@map("role_assignments")
}

enum HydraRole {
  SUPER_ADMIN
  ADMIN_EMPRESA
  GESTOR_SST
  ENGENHEIRO
  TECNICO_SST
  MEDICO
  ENFERMEIRO
  RH
  GESTOR
  COLABORADOR
  PRESTADOR
  CLINICA
  FINANCEIRO
  COMERCIAL
}

enum ScopeType {
  TENANT
  COMPANY
  BRANCH
  UNIT
}

/// Token de redefinição de senha — opaco, hash armazenado, uso único, expira em 1h.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Refresh token opaco, rotacionado a cada uso (ver seção 07).
model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  replacedBy  String?
  createdAt   DateTime  @default(now())
  createdByIp String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Transversal
// ---------------------------------------------------------------------------

/// Log de auditoria — apenas inserção (ver seção 14).
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  action     String // ex.: "employee.create", "auth.login"
  entityType String?
  entityId   String?
  ip         String?
  metadata   Json?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

// ---------------------------------------------------------------------------
// PGR — Programa de Gerenciamento de Riscos (Fase 1, ver seção 06 do escopo)
// ---------------------------------------------------------------------------

enum RiskCategory {
  FISICO
  QUIMICO
  BIOLOGICO
  ERGONOMICO
  ACIDENTE
}

/// Catálogo de perigos/agentes reutilizável entre PGRs do mesmo tenant.
model Hazard {
  id                     String             @id @default(cuid())
  tenantId               String
  category               RiskCategory
  name                   String
  description            String?
  damagePotential        String?
  /// Código eSocial do agente/perigo (ex.: 09.01.001), quando aplicável — igual ao usado no S-2240.
  esocialCode            String?
  /// Fonte ou situação de exposição.
  sourceCircumstances    String?            @db.Text
  observations           String?            @db.Text
  /// Medidas administrativas ou de organização do trabalho (preventivas recomendadas).
  adminMeasures          String?            @db.Text
  exposureType           ExposureType?
  sendEsocial            Boolean            @default(false)
  measurementType        EvaluationCriteria @default(QUALITATIVO)
  generatesUnhealthiness Boolean            @default(false)
  generatesHazardPay     Boolean            @default(false)
  specialRetirement      Boolean            @default(false)
  insertInAso            Boolean            @default(true)
  /// EPCs / EPIs implementam medidas de proteção: "SIM", "NAO" ou "NAO_SE_APLICA".
  epcStatus              String             @default("NAO_SE_APLICA")
  epiStatus              String             @default("NAO_SE_APLICA")
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  deletedAt              DateTime?

  pgrRisks      PgrRisk[]
  positionRisks PositionRisk[]
  protections   HazardProtection[]

  @@index([tenantId])
  @@map("hazards")
}

/// Status compartilhado por todo documento técnico versionado (PGR, PCMSO, LTCAT, laudos).
enum DocumentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ARCHIVED
}

/// Documento PGR — um por empresa/filial, versionado.
model Pgr {
  id            String         @id @default(cuid())
  tenantId      String
  companyId     String
  branchId      String?
  title         String
  /// Código do documento (ex.: PGR-2026-001), livre — não gerado automaticamente.
  code          String?
  version       Int            @default(1)
  status        DocumentStatus @default(DRAFT)
  /// Data de emissão (capa) — distinta de createdAt, que é quando o registro foi salvo no sistema.
  issuedAt      DateTime?
  validFrom     DateTime?
  validUntil    DateTime?
  responsibleId String?

  // Elaborado / revisado / aprovado por (seção 5 — nomes livres, sem vínculo a User)
  preparedBy String?
  reviewedBy String?
  approvedBy String?

  // Bloco de assinatura — Responsável pela Empresa (seção 28)
  companyResponsibleName String?
  companyResponsibleRole String?

  // Bloco de assinatura — Responsável Técnico (seção 29)
  technicalResponsibleName      String?
  technicalResponsibleSpecialty String?
  technicalResponsibleRegistry  String?
  technicalResponsibleCouncil   String?
  technicalResponsibleUf        String?

  // Snapshot da Empresa no momento da criação (CNAE / grau de risco / colaboradores) —
  // o documento não muda sozinho se o cadastro da empresa for editado depois.
  cnae          String?
  grauRisco     Int?
  employeeCount Int?

  // Aba "Plano de ações e recomendações" e "Finalização"
  procedimentoTrabalho    String? @db.Text
  treinamentosNecessarios String? @db.Text
  episRecomendados        String? @db.Text
  metasPrioridades        String? @db.Text
  consideracoesFinais     String? @db.Text

  /// Texto do documento editável (capítulos do modelo em HTML) — substitui o texto padrão no PDF.
  modelHtml   String?   @db.Text
  coordinator String?
  description String?   @db.Text
  /// Data sugerida para renovação do documento.
  renewalAt   DateTime?
  /// Cronogramas de ação da empresa anexados ao PGR.
  scheduleIds String[]

  approvedAt   DateTime?
  approvedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdById  String?
  updatedById  String?

  ghes       Ghe[]
  risks      PgrRisk[]
  actions    PgrAction[]
  cronograma PgrCronogramaItem[]

  @@index([tenantId])
  @@index([companyId])
  @@map("pgrs")
}

/// Linha do Cronograma ("PLANO DE AÇÃO - PGR") — ação livre + responsável em texto
/// livre; os meses marcados ficam em PgrCronogramaMark.
model PgrCronogramaItem {
  id          String   @id @default(cuid())
  tenantId    String
  pgrId       String
  description String
  responsible String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pgr   Pgr                 @relation(fields: [pgrId], references: [id], onDelete: Cascade)
  marks PgrCronogramaMark[]

  @@index([tenantId])
  @@index([pgrId])
  @@map("pgr_cronograma_items")
}

model PgrCronogramaMark {
  id     String @id @default(cuid())
  itemId String
  year   Int
  month  Int // 1-12

  item PgrCronogramaItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, year, month])
  @@map("pgr_cronograma_marks")
}

/// Grupo Homogêneo de Exposição dentro de um PGR — pode reunir mais de um
/// Setor/Cargo (ver GheFunction), conforme o padrão do PGR de referência.
/// `pgrId`/`ltcatId`: um GHE pertence a exatamente um dos dois (nunca ambos, nunca
/// nenhum) — validado na aplicação, já que o Postgres não tem XOR nativo. Isso
/// permite o LTCAT reaproveitar a mesma estrutura de GHE do PGR (Fase 6) sem
/// misturar o ciclo de vida dos dois: cada GHE continua pertencendo a um único
/// documento, só que agora esse documento pode ser um Pgr OU um Ltcat.
model Ghe {
  id                  String   @id @default(cuid())
  tenantId            String
  pgrId               String?
  ltcatId             String?
  name                String
  code                String?
  /// Descrição do local (ex.: "Alvenaria, piso em cerâmica...").
  localDescription    String?  @db.Text
  /// Descrição da atividade do GHE como um todo (distinta da atividade por cargo, ver GheFunction).
  activityDescription String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  pgr         Pgr?          @relation(fields: [pgrId], references: [id])
  ltcat       Ltcat?        @relation(fields: [ltcatId], references: [id])
  risks       PgrRisk[]
  functions   GheFunction[]
  ltcatAgents LtcatAgent[]

  @@index([tenantId])
  @@index([pgrId])
  @@index([ltcatId])
  @@map("ghe")
}

/// Vínculo Setor+Cargo de um GHE — um GHE pode reunir vários cargos de vários
/// setores, cada um com sua própria descrição de atividade (ver PGR de referência,
/// onde um único GHE lista "Cargo X ... Cargo Y ..." de setores diferentes).
model GheFunction {
  id                  String   @id @default(cuid())
  tenantId            String
  gheId               String
  departmentId        String?
  positionId          String?
  activityDescription String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  ghe        Ghe         @relation(fields: [gheId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  position   Position?   @relation(fields: [positionId], references: [id])

  @@index([tenantId])
  @@index([gheId])
  @@map("ghe_functions")
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  IRRELEVANT
}

/// Tipo de exposição ao perigo (seção 17 do PGR de referência).
enum ExposureType {
  EVENTUAL
  INTERMITENTE
  PERMANENTE
  HABITUAL
}

/// Critério de avaliação do risco.
enum EvaluationCriteria {
  QUALITATIVO
  QUANTITATIVO
}

/// Uma linha do inventário de riscos: um perigo avaliado dentro de um GHE.
/// Estrutura de campos espelha exatamente "Identificação / Avaliação / Prevenção
/// e controle" do PGR de referência (HBSA 2025) — ver seções 16-20 do escopo.
model PgrRisk {
  id       String @id @default(cuid())
  tenantId String
  pgrId    String
  gheId    String
  hazardId String

  // Identificação
  /// Descrição do risco neste GHE (se vazia, vale a descrição do perigo).
  description         String? @db.Text
  /// Fundamentação legal (ex.: NR-17 item 17.5).
  legalBasis          String? @db.Text
  /// Possíveis lesões ou agravos à saúde.
  typicalInjuries     String? @db.Text
  /// Fontes ou circunstâncias geradoras do perigo.
  sourceCircumstances String? @db.Text
  /// Meio de propagação (ex.: "Pelo ar", "Contato"), quando aplicável.
  propagationMeans    String?

  // Avaliação
  /// Tempo de exposição (ex.: "04:00").
  exposureTime       String?
  exposureType       ExposureType?
  evaluationCriteria EvaluationCriteria?
  /// Perfil de exposição em texto livre (ex.: "Habitual e permanente").
  exposureProfile    String?
  probability        Int // 1-5
  severity           Int // 1-5
  riskLevel          RiskLevel
  /// Classificação conforme a metodologia do PGR de referência (ex.: "Aceitável",
  /// "Tolerável") — texto livre porque a escala completa não está confirmada
  /// (matriz visual do documento de referência, não extraída como texto).
  classification     String?
  /// Conclusão específica deste risco (narrativa), quando aplicável.
  conclusion         String?             @db.Text

  // Prevenção e controle (hierarquia de controles — seção 21)
  adminControls       String? @db.Text
  engineeringControls String? @db.Text
  epcMeasures         String? @db.Text
  epiMeasures         String? @db.Text
  /// Utiliza EPC / EPC eficaz / Utiliza EPI / EPI eficaz: "SIM", "NAO" ou "NAO_SE_APLICA".
  usesEpc             String?
  epcEffective        String?
  usesEpi             String?
  epiEffective        String?
  /// Ações necessárias (ex.: "Treinamento de NR17 - Ergonomia").
  requiredActions     String? @db.Text
  /// Orientação aos trabalhadores.
  guidance            String? @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  pgr     Pgr         @relation(fields: [pgrId], references: [id])
  ghe     Ghe         @relation(fields: [gheId], references: [id])
  hazard  Hazard      @relation(fields: [hazardId], references: [id])
  actions PgrAction[]

  @@index([tenantId])
  @@index([pgrId])
  @@index([gheId])
  @@map("pgr_risks")
}

enum ActionStatus {
  OPEN
  IN_PROGRESS
  LATE
  VALIDATING
  DONE
  CANCELED
}

/// Item do plano de ações — pode nascer de um risco do PGR ou ser avulso
/// (inspeção, incidente, auditoria — módulos futuros reaproveitam esta tabela).
model PgrAction {
  id              String       @id @default(cuid())
  tenantId        String
  companyId       String? // denormalizado para permitir contagem por empresa (dashboard)
  pgrId           String?
  pgrRiskId       String?
  nonConformityId String?
  description     String
  responsibleId   String?
  dueDate         DateTime?
  priority        Int          @default(2) // 1 alta, 2 média, 3 baixa
  status          ActionStatus @default(OPEN)
  evidenceUrl     String?
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  createdById     String?
  updatedById     String?

  pgr           Pgr?           @relation(fields: [pgrId], references: [id])
  pgrRisk       PgrRisk?       @relation(fields: [pgrRiskId], references: [id])
  nonConformity NonConformity? @relation(fields: [nonConformityId], references: [id])

  @@index([tenantId])
  @@index([pgrId])
  @@index([status])
  @@index([companyId])
  @@map("pgr_actions")
}

// ---------------------------------------------------------------------------
// Saúde ocupacional (Fase 2)
// ---------------------------------------------------------------------------

/// Documento PCMSO — mesmo padrão de versionamento do PGR.
model Pcmso {
  id            String         @id @default(cuid())
  tenantId      String
  companyId     String
  branchId      String?
  title         String
  version       Int            @default(1)
  status        DocumentStatus @default(DRAFT)
  validFrom     DateTime?
  validUntil    DateTime?
  responsibleId String?
  approvedAt    DateTime?
  approvedById  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  createdById   String?
  updatedById   String?

  exams MedicalExam[]

  @@index([tenantId])
  @@index([companyId])
  @@map("pcmso")
}

enum ExamType {
  ADMISSIONAL
  PERIODICO
  DEMISSIONAL
  RETORNO_TRABALHO
  MUDANCA_RISCO
}

enum ExamResult {
  APTO
  INAPTO
  PENDENTE
}

model MedicalExam {
  id          String     @id @default(cuid())
  tenantId    String
  employeeId  String
  pcmsoId     String?
  type        ExamType
  scheduledAt DateTime?
  performedAt DateTime?
  result      ExamResult @default(PENDENTE)
  nextDueAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdById String?

  pcmso    Pcmso?   @relation(fields: [pcmsoId], references: [id])
  aso      Aso?
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
  @@map("medical_exams")
}

/// Atestado de Saúde Ocupacional emitido a partir de um exame.
model Aso {
  id          String     @id @default(cuid())
  tenantId    String
  examId      String     @unique
  result      ExamResult
  issuedAt    DateTime   @default(now())
  physicianId String?
  fileUrl     String?
  createdAt   DateTime   @default(now())

  exam MedicalExam @relation(fields: [examId], references: [id])

  @@index([tenantId])
  @@map("asos")
}

// ---------------------------------------------------------------------------
// Ocorrências — incidentes, acidentes, investigação e CAT (Fase 2)
// ---------------------------------------------------------------------------

enum OccurrenceType {
  INCIDENT
  NEAR_MISS
  ACCIDENT_TYPICAL
  ACCIDENT_COMMUTE
  OCCUPATIONAL_DISEASE
}

enum OccurrenceStatus {
  OPEN
  INVESTIGATING
  CLOSED
}

model Occurrence {
  id               String           @id @default(cuid())
  tenantId         String
  companyId        String
  branchId         String?
  unitId           String?
  employeeId       String?
  type             OccurrenceType
  highPotential    Boolean          @default(false)
  description      String
  location         String?
  immediateActions String?          @db.Text
  occurredAt       DateTime
  status           OccurrenceStatus @default(OPEN)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  createdById      String?
  updatedById      String?

  investigation  Investigation?
  cat            Cat?
  involvedPeople OccurrenceInvolvedPerson[]

  @@index([tenantId])
  @@index([companyId])
  @@index([type])
  @@map("occurrences")
}

enum InvestigationMethod {
  FIVE_WHYS
  ISHIKAWA
}

/// Investigação de causa raiz de uma ocorrência (item 15 do escopo).
model Investigation {
  id             String              @id @default(cuid())
  tenantId       String
  occurrenceId   String              @unique
  method         InvestigationMethod
  immediateCause String?
  rootCause      String?
  findings       String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  createdById    String?

  occurrence Occurrence @relation(fields: [occurrenceId], references: [id])

  @@index([tenantId])
  @@map("investigations")
}

enum CatType {
  TYPICAL
  COMMUTE
  DISEASE
}

enum CatStatus {
  DRAFT
  SENT
  ACKNOWLEDGED
  REJECTED
}

/// Comunicação de Acidente de Trabalho, vinculada 1:1 a uma ocorrência.
model Cat {
  id           String    @id @default(cuid())
  tenantId     String
  occurrenceId String    @unique
  type         CatType
  leaveDays    Int?
  status       CatStatus @default(DRAFT)
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String?

  occurrence Occurrence @relation(fields: [occurrenceId], references: [id])

  @@index([tenantId])
  @@map("cats")
}

enum OccurrenceInvolvedPersonRole {
  VITIMA
  TESTEMUNHA
  ENVOLVIDO
}

/// Pessoa envolvida numa ocorrência (vítima, testemunha etc.) — uma ocorrência
/// pode ter várias, ao contrário do único `employeeId` opcional do registro.
model OccurrenceInvolvedPerson {
  id           String                       @id @default(cuid())
  tenantId     String
  occurrenceId String
  employeeId   String?
  name         String?
  role         OccurrenceInvolvedPersonRole
  createdAt    DateTime                     @default(now())

  occurrence Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([occurrenceId])
  @@map("occurrence_involved_people")
}

enum BehaviorObservationCategory {
  ATO_SEGURO
  ATO_INSEGURO
  CONDICAO_SEGURA
  CONDICAO_INSEGURA
}

/// Observação comportamental de segurança (BBS) — registro de campo,
/// independente de inspeção ou incidente.
model BehaviorObservation {
  id                 String                      @id @default(cuid())
  tenantId           String
  companyId          String
  branchId           String?
  observerId         String?
  observedEmployeeId String?
  category           BehaviorObservationCategory
  description        String                      @db.Text
  actionTaken        String?                     @db.Text
  createdAt          DateTime                    @default(now())
  createdById        String?

  @@index([tenantId])
  @@index([companyId])
  @@map("behavior_observations")
}

// ---------------------------------------------------------------------------
// Operação de campo — Inspeções, Não Conformidades e Evidências (Fase 2)
// ---------------------------------------------------------------------------

/// Roteiro/modelo reutilizável de inspeção de campo.
model InspectionTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  companyId   String?
  name        String
  description String?  @db.Text
  category    String?
  /// false = excluído (legado); o ciclo de vida normal usa `status`.
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  /// Código automático (CHK-0001), igual em todas as versões do mesmo modelo.
  code              String?
  status            ChecklistTemplateStatus @default(ATIVO)
  version           Int                     @default(1)
  /// Versão anterior do mesmo modelo (cada edição de um modelo já usado cria uma versão nova).
  previousVersionId String?
  frequency         ChecklistFrequency?
  branchId          String? /// unidade relacionada
  departmentId      String? /// setor relacionado
  process           String? /// processo relacionado
  responsibleId     String? /// responsável pelo modelo (usuário)
  ncCreation        NonConformityCreation   @default(MANUAL)

  sections    InspectionTemplateSection[]
  items       InspectionTemplateItem[]
  inspections Inspection[]
  history     InspectionTemplateHistory[]

  @@unique([tenantId, code, version])
  @@index([tenantId])
  @@index([companyId])
  @@map("inspection_templates")
}

/// Seção de um modelo de checklist (agrupa perguntas).
model InspectionTemplateSection {
  id          String  @id @default(cuid())
  tenantId    String
  templateId  String
  name        String
  order       Int
  /// Seção repetível: ao aplicar o checklist, pode ser preenchida várias vezes (ex.: um setor ou risco por vez).
  repeatable  Boolean @default(false)
  repeatLabel String?

  template InspectionTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items    InspectionTemplateItem[]

  @@index([tenantId])
  @@index([templateId])
  @@map("inspection_template_sections")
}

/// Histórico de alterações de um modelo (criação, edição, mudança de status, nova versão...).
model InspectionTemplateHistory {
  id         String   @id @default(cuid())
  tenantId   String
  templateId String
  userId     String?
  userName   String?
  action     String
  details    String?  @db.Text
  createdAt  DateTime @default(now())

  template InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([templateId])
  @@map("inspection_template_history")
}

enum InspectionItemType {
  CONFORME_NAO_CONFORME
  SIM_NAO
  NOTA
  TEXTO_LIVRE
  SELECAO_MULTIPLA
  TEXTO_CURTO
  TEXTO_LONGO
  SELECAO_UNICA
  NUMERO
  DATA
  HORA
  ESCALA
  LISTA_SUSPENSA
  UPLOAD
  CLASSIFICACAO
  GRADE
}

/// Situação do modelo de checklist. Só modelos ATIVO aparecem para aplicação.
enum ChecklistTemplateStatus {
  RASCUNHO
  ATIVO
  INATIVO
  ARQUIVADO
}

enum ChecklistFrequency {
  DIARIA
  SEMANAL
  MENSAL
  POR_TURNO
  POR_EVENTO
  PERSONALIZADA
}

/// Como nasce a não conformidade quando uma resposta é "não conforme": sozinha ou por decisão de quem aplica.
enum NonConformityCreation {
  MANUAL
  AUTOMATICA
}

/// Item do roteiro de inspeção (pergunta/verificação).
model InspectionTemplateItem {
  id           String             @id @default(cuid())
  tenantId     String
  templateId   String
  order        Int
  text         String
  responseType InspectionItemType @default(CONFORME_NAO_CONFORME)
  category     String?
  options      String[]           @default([]) // opções de escolha quando responseType = SELECAO_MULTIPLA
  blockLabel   String? // nome do InspectionBlock de origem, congelado no momento em que foi inserido no roteiro
  allowPhoto   Boolean            @default(true) // se falso, não mostra a opção de anexar foto/evidência pra este item

  sectionId         String?
  /// Orientação mostrada junto da pergunta.
  instruction       String?  @db.Text
  required          Boolean  @default(false)
  /// Peso/pontuação (quando aplicável).
  weight            Int?
  allowComment      Boolean  @default(true)
  allowActionPlan   Boolean  @default(false)
  /// Escala de avaliação (tipo ESCALA): de scaleMin a scaleMax.
  scaleMin          Int?
  scaleMax          Int?
  scaleMinLabel     String?
  scaleMaxLabel     String?
  /// Linhas da grade (tipo GRADE); as colunas ficam em `options`.
  rows              String[] @default([])
  /// Regra condicional: a pergunta só aparece se a resposta da pergunta `conditionItemId` for/não for `conditionValue`.
  conditionItemId   String?
  conditionOperator String? // "IGUAL" | "DIFERENTE"
  conditionValue    String?

  section   InspectionTemplateSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  template  InspectionTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  responses InspectionItemResponse[]

  @@index([tenantId])
  @@index([templateId])
  @@map("inspection_template_items")
}

/// Bloco reutilizável de itens de checklist — biblioteca pra montar roteiros sem
/// redigitar; ao ser inserido num InspectionTemplate, seus itens são copiados
/// (snapshot) e passam a ser independentes — editar o bloco depois não afeta
/// roteiros que já o usaram.
model InspectionBlock {
  id          String   @id @default(cuid())
  tenantId    String
  companyId   String?
  name        String
  description String?  @db.Text
  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items InspectionBlockItem[]

  @@index([tenantId])
  @@map("inspection_blocks")
}

model InspectionBlockItem {
  id           String             @id @default(cuid())
  tenantId     String
  blockId      String
  order        Int
  text         String
  responseType InspectionItemType @default(CONFORME_NAO_CONFORME)
  category     String?
  options      String[]           @default([])
  allowPhoto   Boolean            @default(true)

  block InspectionBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([blockId])
  @@map("inspection_block_items")
}

enum InspectionStatus {
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

/// Uma inspeção de campo realizada a partir de um roteiro.
model Inspection {
  id           String           @id @default(cuid())
  tenantId     String
  companyId    String
  branchId     String?
  departmentId String?
  templateId   String
  inspectorId  String?
  status       InspectionStatus @default(EM_ANDAMENTO)
  scheduledAt  DateTime?
  startedAt    DateTime         @default(now())
  completedAt  DateTime?
  notes        String?          @db.Text
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  createdById  String?

  template        InspectionTemplate       @relation(fields: [templateId], references: [id])
  responses       InspectionItemResponse[]
  nonConformities NonConformity[]

  @@index([tenantId])
  @@index([companyId])
  @@index([templateId])
  @@map("inspections")
}

enum InspectionResponseValue {
  CONFORME
  NAO_CONFORME
  NAO_APLICAVEL
}

/// Resposta a um item do roteiro dentro de uma inspeção específica.
model InspectionItemResponse {
  id             String                   @id @default(cuid())
  tenantId       String
  inspectionId   String
  templateItemId String
  value          InspectionResponseValue?
  textValue      String?                  @db.Text
  comment        String?                  @db.Text
  order          Int
  /// Qual repetição da seção repetível esta resposta pertence (0 = primeira / seção normal).
  repetition     Int                      @default(0)
  createdAt      DateTime                 @default(now())

  inspection      Inspection             @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  templateItem    InspectionTemplateItem @relation(fields: [templateItemId], references: [id])
  nonConformities NonConformity[]

  @@index([tenantId])
  @@index([inspectionId])
  @@map("inspection_item_responses")
}

enum NonConformitySeverity {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum NonConformityStatus {
  ABERTA
  EM_TRATATIVA
  RESOLVIDA
}

/// Não conformidade identificada em campo — pode nascer de uma inspeção ou
/// de um item específico dela; alimenta o plano de ações via PgrAction.
model NonConformity {
  id                       String                @id @default(cuid())
  tenantId                 String
  companyId                String
  inspectionId             String?
  inspectionItemResponseId String?
  description              String                @db.Text
  severity                 NonConformitySeverity @default(MEDIA)
  status                   NonConformityStatus   @default(ABERTA)
  dueDate                  DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  createdById              String?

  inspection             Inspection?             @relation(fields: [inspectionId], references: [id])
  inspectionItemResponse InspectionItemResponse? @relation(fields: [inspectionItemResponseId], references: [id])
  actions                PgrAction[]

  @@index([tenantId])
  @@index([companyId])
  @@index([inspectionId])
  @@map("non_conformities")
}

/// De onde uma evidência (foto/anexo) vem — transversal a vários módulos.
enum EvidenceSourceType {
  INSPECTION
  INSPECTION_ITEM_RESPONSE
  NON_CONFORMITY
  BEHAVIOR_OBSERVATION
  OCCURRENCE
  ACTION
  AUDIT
  PGR
}

/// Evidência (foto/anexo) transversal — identifica a origem por
/// sourceType+sourceId em vez de uma FK por módulo (são 8 origens possíveis;
/// uma FK por origem, como em PgrAction, ficaria inviável aqui).
model Evidence {
  id           String             @id @default(cuid())
  tenantId     String
  companyId    String?
  sourceType   EvidenceSourceType
  sourceId     String
  fileUrl      String
  fileName     String
  mimeType     String?
  caption      String?
  /// Agrupa anexos dentro de uma mesma origem (ex.: anexos do PGR).
  category     String?
  uploadedById String?
  createdAt    DateTime           @default(now())

  @@index([tenantId])
  @@index([sourceType, sourceId])
  @@map("evidences")
}

// ---------------------------------------------------------------------------
// CIPA (Fase 2)
// ---------------------------------------------------------------------------

enum CipaTermStatus {
  PLANNED
  ACTIVE
  CLOSED
}

/// Mandato/gestão da CIPA.
model CipaTerm {
  id        String         @id @default(cuid())
  tenantId  String
  companyId String
  branchId  String?
  startDate DateTime
  endDate   DateTime
  status    CipaTermStatus @default(PLANNED)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  members CipaMember[]

  @@index([tenantId])
  @@index([companyId])
  @@map("cipa_terms")
}

enum CipaMemberRole {
  TITULAR
  SUPLENTE
}

enum CipaRepresentation {
  EMPREGADOR
  EMPREGADOS
}

model CipaMember {
  id             String             @id @default(cuid())
  tenantId       String
  termId         String
  employeeId     String
  role           CipaMemberRole
  representation CipaRepresentation
  createdAt      DateTime           @default(now())

  term CipaTerm @relation(fields: [termId], references: [id])

  @@index([tenantId])
  @@index([termId])
  @@map("cipa_members")
}

enum CipaElectionType {
  PRIMEIRA
  RENOVACAO
}

enum CipaScheduleOrigin {
  LEGAL
  PROGRAMADA
}

/// Processo eleitoral da CIPA (dimensionamento + cronograma de prazos legais).
model CipaElection {
  id                      String           @id @default(cuid())
  tenantId                String
  companyId               String
  branchId                String?
  type                    CipaElectionType
  grauRisco               Int
  gestaoLabel             String
  posseDate               DateTime
  dataTerminoMandatoAtual DateTime?
  previousTermId          String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  createdById             String?

  steps CipaElectionScheduleStep[]

  @@index([tenantId])
  @@index([companyId])
  @@map("cipa_elections")
}

/// Etapa do cronograma legal/programado de uma eleição da CIPA.
model CipaElectionScheduleStep {
  id            String             @id @default(cuid())
  tenantId      String
  electionId    String
  etapa         String
  regra         String
  origem        CipaScheduleOrigin
  baseLegal     String?
  diasRelativos Int
  data          DateTime
  concluido     Boolean            @default(false)
  order         Int

  election CipaElection @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([electionId])
  @@map("cipa_election_schedule_steps")
}

