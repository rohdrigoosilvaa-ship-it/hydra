{
  "name": "hydra",
  "private": true,
  "version": "0.1.0",
  "description": "HYDRA — Plataforma Integrada de Gestão de Saúde e Segurança do Trabalho",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @hydra/db generate",
    "db:migrate": "pnpm --filter @hydra/db migrate",
    "db:seed": "pnpm --filter @hydra/db seed"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  }
}
